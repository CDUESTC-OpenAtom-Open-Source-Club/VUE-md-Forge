{
  "name": "vue-md-forge",
  "version": "0.1.0",
  "description": "A Vue 3 Markdown editor plugin with character auto-pairing, dual-pane source preview, local highlight.js and KaTeX, and CSP-friendly zero-CDN output.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CDUESTC-OpenAtom-Open-Source-Club/VUE-md-Forge.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "editor",
    "markdown-editor",
    "katex",
    "highlight.js",
    "csp"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/vue-md-forge.umd.cjs",
  "module": "./dist/vue-md-forge.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-md-forge.js",
      "require": "./dist/vue-md-forge.umd.cjs"
    },
    "./style.css": "./dist/vue-md-forge.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vue-tsc --noEmit && vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@vscode/markdown-it-katex": "^1.1.1",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "markdown-it": "^14.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.5.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue": "^3.5.14",
    "vue-tsc": "^2.2.0"
  }
}
